# fhish-cli/docker/Dockerfile.relayer
FROM node:20-alpine AS builder

RUN apk add --no-cache git
WORKDIR /app

# Try to use local Relayer, fallback to clone
COPY src/fhish-relayer-v2 .
RUN if [ ! -f package.json ]; then \
    git clone https://github.com/fhish-tech/fhish-relayer-v2.git . ; \
    fi

RUN npm install --no-audit --no-fund --legacy-peer-deps && \
    if [ -f "tsconfig.json" ]; then npx tsc; fi

FROM node:20-alpine
RUN apk add --no-cache jq bash
WORKDIR /app
COPY --from=builder /app ./
COPY docker/scripts/start-relayer.sh /start-relayer.sh
RUN chmod +x /start-relayer.sh

ENTRYPOINT ["/start-relayer.sh"]
