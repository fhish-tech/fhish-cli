# fhish-cli/docker/Dockerfile.gateway
FROM node:20-alpine AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y git

# Clone dependencies
RUN git clone https://github.com/fhish-tech/fhish-wasm.git /packages/fhish-wasm && \
    git clone https://github.com/fhish-tech/fhish-gateway.git /app-src

# Copy gateway source from cloned repo
WORKDIR /app
RUN cp -r /app-src/* ./ && \
    npm install --no-audit --no-fund --legacy-peer-deps && \
    npm run build || echo "Build step skipped"

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app /app
COPY --from=builder /packages /packages

# Ensure keys directory exists
RUN mkdir -p /app/keys

ENTRYPOINT ["npm", "start"]
