# fhish-cli/docker/Dockerfile.deployer
FROM ghcr.io/foundry-rs/foundry:latest AS foundry

FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y curl git jq && rm -rf /var/lib/apt/lists/*

# Copy foundry binaries
COPY --from=foundry /usr/local/bin/forge /usr/local/bin/forge
COPY --from=foundry /usr/local/bin/cast /usr/local/bin/cast
COPY --from=foundry /usr/local/bin/anvil /usr/local/bin/anvil

WORKDIR /contracts

WORKDIR /contracts
RUN git clone https://github.com/fhish-tech/fhish-contracts-v2.git .

# Install npm deps if needed
RUN if [ -f "package.json" ]; then npm install --no-audit --no-fund --legacy-peer-deps; fi

COPY docker/scripts/deploy-contracts.sh /deploy-contracts.sh
RUN chmod +x /deploy-contracts.sh

ENTRYPOINT ["/deploy-contracts.sh"]
